{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "directory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "responsibility": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string"
        },
        "website": {
          "type": "string"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "hours": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "city",
              "staff",
              "water",
              "works",
              "police",
              "wards",
              "clerk",
              "planning",
              "codes",
              "fire",
              "parks",
              "tax",
              "library",
              "meetings",
              "notices",
              "legal",
              "newsletter",
              "app",
              "opd-blotters",
              "opd-news",
              "opd-warrants",
              "ny-alert",
              "county-alert",
              "housing",
              "school",
              "grid",
              "branding"
            ]
          }
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "emergency": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "organization",
        "questions",
        "responsibility",
        "jurisdiction",
        "source_ids",
        "last_verified"
      ],
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source_entry_id": {
          "type": "string"
        },
        "source_title": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "agency": {
          "type": "string"
        },
        "incident_type": {
          "type": "string"
        },
        "offense_category": {
          "type": "string"
        },
        "neutral_summary": {
          "type": "string"
        },
        "review_notes": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "enum": [
            "city",
            "staff",
            "water",
            "works",
            "police",
            "wards",
            "clerk",
            "planning",
            "codes",
            "fire",
            "parks",
            "tax",
            "library",
            "meetings",
            "notices",
            "legal",
            "newsletter",
            "app",
            "opd-blotters",
            "opd-news",
            "opd-warrants",
            "ny-alert",
            "county-alert",
            "housing",
            "school",
            "grid",
            "branding"
          ]
        },
        "event_date": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_time": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_date": {
          "type": "string",
          "format": "date"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "location_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "location_precision": {
          "enum": [
            "unknown",
            "street",
            "block",
            "exact"
          ]
        },
        "geometry": {
          "type": [
            "object",
            "null"
          ]
        },
        "geometry_confidence": {
          "enum": [
            "unknown",
            "pending",
            "verified"
          ]
        },
        "geometry_source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "officially_named_arrestee": {
          "type": [
            "string",
            "null"
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 18
        },
        "alleged_offenses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disposition": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_status": {
          "enum": [
            "pending",
            "reviewed",
            "withdrawn"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "source_entry_id",
        "source_id",
        "event_date",
        "event_time",
        "publication_date",
        "incident_type",
        "geometry",
        "geometry_confidence",
        "neutral_summary",
        "review_status",
        "last_verified"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "geometry": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "geometry_confidence": {
                "const": "verified"
              },
              "geometry_source_url": {
                "type": "string",
                "format": "uri"
              },
              "location_text": {
                "type": "string"
              }
            },
            "required": [
              "geometry_source_url",
              "location_text"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "officially_named_arrestee": {
                "type": "string"
              }
            },
            "required": [
              "officially_named_arrestee"
            ]
          },
          "then": {
            "properties": {
              "age": {
                "type": "integer",
                "minimum": 18
              }
            },
            "required": [
              "age"
            ]
          }
        }
      ]
    },
    "sources": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "publisher": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        },
        "integration_mode": {
          "type": "string"
        },
        "coverage": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "source_type",
        "last_verified",
        "notes"
      ],
      "additionalProperties": false
    },
    "channels": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "best_for": {
          "type": "string"
        },
        "delivery": {
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "enum": [
            "city",
            "staff",
            "water",
            "works",
            "police",
            "wards",
            "clerk",
            "planning",
            "codes",
            "fire",
            "parks",
            "tax",
            "library",
            "meetings",
            "notices",
            "legal",
            "newsletter",
            "app",
            "opd-blotters",
            "opd-news",
            "opd-warrants",
            "ny-alert",
            "county-alert",
            "housing",
            "school",
            "grid",
            "branding"
          ]
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "title",
        "best_for",
        "delivery",
        "group",
        "action",
        "source_id",
        "last_verified"
      ],
      "additionalProperties": false
    },
    "meetings": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "enum": [
            "city",
            "staff",
            "water",
            "works",
            "police",
            "wards",
            "clerk",
            "planning",
            "codes",
            "fire",
            "parks",
            "tax",
            "library",
            "meetings",
            "notices",
            "legal",
            "newsletter",
            "app",
            "opd-blotters",
            "opd-news",
            "opd-warrants",
            "ny-alert",
            "county-alert",
            "housing",
            "school",
            "grid",
            "branding"
          ]
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "agenda_available": {
          "type": "boolean"
        },
        "packet_available": {
          "type": "boolean"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "title",
        "start",
        "source_id",
        "location",
        "last_verified"
      ],
      "additionalProperties": false
    },
    "safety-archive": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "publication_date": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "enum": [
            "city",
            "staff",
            "water",
            "works",
            "police",
            "wards",
            "clerk",
            "planning",
            "codes",
            "fire",
            "parks",
            "tax",
            "library",
            "meetings",
            "notices",
            "legal",
            "newsletter",
            "app",
            "opd-blotters",
            "opd-news",
            "opd-warrants",
            "ny-alert",
            "county-alert",
            "housing",
            "school",
            "grid",
            "branding"
          ]
        },
        "review_status": {
          "const": "index-only"
        },
        "last_verified": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "id",
        "title",
        "publication_date",
        "source_id",
        "review_status",
        "last_verified"
      ],
      "additionalProperties": false
    }
  }
}
